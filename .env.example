# ============================================
# Abakosoft - Variables de entorno (plantilla)
# Copia este archivo como .env y ajusta los valores
# ============================================

# --- Base de datos ---
DB_HOST=db
DB_USER=root
DB_PASSWORD=masterkey
DB_NAME=gestion_abako
DB_PORT=3306
MASTER_DB_NAME=abakosoft_master

# --- Backend ---
PORT=3002
JWT_SECRET=cambia_este_secreto
SAAS_JWT_SECRET=cambia_este_secreto_saas
SAAS_REFRESH_JWT_SECRET=cambia_este_secreto_refresh
SAAS_SEED_ADMIN_PASSWORD=cambia_esta_password_admin

# --- Frontend / CORS ---
# Lista separada por comas de URLs permitidas (frontend en dev y prod)
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001

# --- Cookies SaaS ---
# sameSite: lax | strict | none  (none requiere SAAS_COOKIE_SECURE=true y HTTPS)
SAAS_COOKIE_SAMESITE=lax
SAAS_COOKIE_SECURE=false
# Opcional: dominio de la cookie (ej: .midominio.com)
# SAAS_COOKIE_DOMAIN=

# --- Zona horaria (opcional, por defecto America/Bogota) ---
# APP_TZ=America/Bogota